# ── Bash 4.3+ gereksinimi ─────────────────────────────────────────────
# macOS varsayılan /bin/bash 3.2'dir; associative array (declare -A) ve
# nameref (local -n) desteklemez. Homebrew bash kuruluysa onunla yeniden başlat.
if [[ -z "${BASH_VERSINFO:-}" ]] || (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
    for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        [[ -x "$_b" ]] && exec "$_b" "$0" "$@"
    done
    echo "Bu script bash 4.3+ gerektirir (declare -A, local -n). Kur: brew install bash" >&2
    exit 1
fi

