mod_brew_report() {
    have brew || { module_skipped "brew yok"; return 99; }
    local f c fc cc
    capture_stdout f brew outdated --formula --quiet || true
    capture_stdout c brew outdated --cask --greedy --quiet || true
    fc=$(line_count "$f"); cc=$(line_count "$c")
    log "Brew formulae outdated (${fc}):"; [[ -n "$f" ]] && log "$f" || log "  yok"
    log "Brew cask outdated --greedy (${cc}):"; [[ -n "$c" ]] && log "$c" || log "  yok"
    module_reported "$((fc+cc)) paket güncellemesi"
}

mod_mas_report() {
    have mas || { module_skipped "mas yok"; return 99; }
    local out rc count
    capture_logged out mas outdated; rc=$?
    (( QUIET == 0 )) && printf '%s\n' "$out"
    (( rc != 0 )) && { module_failed "mas sorgusu başarısız"; return $rc; }
    count=$(awk '/^[[:space:]]*[0-9]+[[:space:]]/{n++} END{print n+0}' <<<"$out")
    module_reported "$count App Store güncellemesi"
}

mod_softwareupdate_report() {
    [[ $SKIP_SYSTEM -eq 1 ]] && { module_skipped "--skip-system"; return 99; }
    local out rc count
    capture_logged out softwareupdate --list; rc=$?
    (( QUIET == 0 )) && softwareupdate_filter "$out"
    (( rc != 0 )) && { module_failed "softwareupdate sorgusu başarısız"; return $rc; }
    count=$(grep -c '^\* Label:' <<<"$out" || true)
    PENDING_UPDATES=$count
    module_reported "$count sistem güncellemesi"
}

mod_node_report() {
    local did=0 out count=0 volta_todo
    if have npm; then
        capture_logged out npm outdated -g || true
        log "npm global outdated:"; [[ -n "$out" ]] && log "$out" || log "  yok"
        capture_stdout out npm outdated -g --json || true
        count=$((count + $(line_count "$(npm_outdated_names "$out")"))); did=1
        if have volta; then
            volta_todo=$(volta_pending "$(volta_packages)")
            log "volta paketleri:"
            if [[ -n "$volta_todo" ]]; then
                log "$(awk -F'\t' 'NF {printf "  %s %s → %s\n", $1, $2, $3}' <<<"$volta_todo")"
                # sürümü sorgulanamayan ("?") paket güncelleme sayılmaz
                count=$((count + $(awk -F'\t' 'NF && $3 != "?" {n++} END {print n+0}' <<<"$volta_todo")))
            else
                log "  güncel"
            fi
        fi
    fi
    if have pnpm; then capture_logged out pnpm outdated -g || true; log "pnpm global outdated:"; [[ -n "$out" ]] && log "$out" || log "  yok"; did=1; fi
    (( did == 0 )) && { module_skipped "Node paket yöneticisi yok"; return 99; }
    module_reported "$count npm global güncellemesi"
}

mod_python_report() {
    local did=0 out
    if have pipx; then
        if pipx upgrade-all --help 2>&1 | grep -q -- '--dry-run'; then capture_logged out pipx upgrade-all --dry-run || true
        else capture_logged out pipx list --short || true; fi
        log "$out"; did=1
    fi
    have poetry && { log "Poetry: $(poetry --version 2>/dev/null)"; did=1; }
    have uv && { log "uv: $(uv --version 2>/dev/null)"; did=1; }
    (( did == 0 )) && { module_skipped "Python araç yöneticisi yok"; return 99; }
    module_reported "Python araçları listelendi"
}

mod_rust_report() {
    have rustup || { module_skipped "rustup yok"; return 99; }
    local out
    capture_logged out rustup check || true; log "$out"
    if have cargo && cargo install-update --version >/dev/null 2>&1; then
        if cargo install-update --help 2>&1 | grep -q -- '--dry-run'; then capture_logged out cargo install-update -a --dry-run || true; log "$out"; fi
    fi
    module_reported "Rust toolchain kontrol edildi"
}

mod_ruby_report() {
    local gem_bin out count bad
    gem_bin=$(ruby_gem_bin) || { module_skipped "gem yok"; return 99; }
    capture_stdout out env -u GEM_HOME -u GEM_PATH "$gem_bin" outdated || true
    log "Ruby gems outdated:"; [[ -n "$out" ]] && log "$out" || log "  yok"
    count=$(line_count "$(gem_user_outdated "$out" "$(ruby_shipped_gems "$gem_bin" || true)")")
    if bad=$(ruby_permission_problem "$gem_bin"); then warn "Ruby yazma izni sorunu: $bad"; fi
    module_reported "$count gem güncellemesi"
}

mod_go_report() {
    have go || { module_skipped "go yok"; return 99; }
    log "$(go version 2>/dev/null)"
    log "Go build cache: $(human_kb "$(disk_used_kb "$(go env GOCACHE 2>/dev/null)")")"
    log "Go module cache: $(human_kb "$(disk_used_kb "$(go env GOMODCACHE 2>/dev/null)")")"
    have gup && { local out; capture_logged out gup check || true; log "$out"; }
    module_reported "Go sürümü ve cache raporlandı"
}

mod_docker_report() {
    [[ $SKIP_DOCKER -eq 1 ]] && { module_skipped "--skip-docker"; return 99; }
    have docker || { module_skipped "docker yok"; return 99; }
    docker info >/dev/null 2>&1 || { module_skipped "Docker daemon kapalı"; return 99; }
    sh_run docker system df || true
    module_reported "Docker disk kullanımı"
}

mod_cache_report() {
    log "Homebrew cache : $(human_kb "$(disk_used_kb "$HOME/Library/Caches/Homebrew")")"
    log "npm cache      : $(human_kb "$(disk_used_kb "$HOME/.npm/_cacache")")"
    log "uv cache       : $(human_kb "$(disk_used_kb "$HOME/.cache/uv")")"
    log "Xcode Derived  : $(human_kb "$(disk_used_kb "$HOME/Library/Developer/Xcode/DerivedData")")"
    module_reported "cache boyutları"
}

mod_brew_services_report() {
    have brew || { module_skipped "brew yok"; return 99; }
    brew_services_check || { module_failed "servis listesi alınamadı"; return 1; }
    module_reported "$BREW_SVC_DETAIL"
}


# ═════════════════════════════════════════════════════════════════════
# ÇALIŞTIR
# ═════════════════════════════════════════════════════════════════════

for _grp in "${GROUP_ORDER[@]}"; do
    group_enabled "$_grp" || continue
    for _entry in "${MODULE_REGISTRY[@]}"; do
        IFS=: read -r _g _name _fn <<<"$_entry"
        [[ "$_g" == "$_grp" ]] && run_module "$_name" "$_fn"
    done
done
unset _grp _entry _g _name _fn

# ═════════════════════════════════════════════════════════════════════
# ÖZET / JSON / BİLDİRİM
# ═════════════════════════════════════════════════════════════════════
END_TS=$(date +%s)
ELAPSED=$((END_TS - START_TS))
MIN=$((ELAPSED / 60)); SEC=$((ELAPSED % 60))
DISK_FREE_AFTER=$(disk_free_gb)
DISK_DELTA=$((DISK_FREE_AFTER - DISK_FREE_BEFORE))

calculate_health() {
    local score=100
    score=$((score - ${#FAILURES[@]} * 20))
    score=$((score - ${#PARTIALS[@]} * 8))
    score=$((score - ${#AVAILABLE[@]} * 3))
    if (( PENDING_UPDATES > 0 )); then
        local pending_penalty=$((PENDING_UPDATES * 2))
        (( pending_penalty > 10 )) && pending_penalty=10
        score=$((score-pending_penalty))
    fi
    if (( DISK_FREE_AFTER < 10 )); then score=$((score-15))
    elif (( DISK_FREE_AFTER < 20 )); then score=$((score-5)); fi
    (( REBOOT_REQUIRED == 1 )) && score=$((score-5))
    (( score < 0 )) && score=0
    (( score > 100 )) && score=100
    HEALTH_SCORE=$score
}

json_escape() {
    local s="$1"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

compute_exit_code() {
    if (( ${#FAILURES[@]} > 0 )); then EXIT_CODE=1
    elif (( ${#PARTIALS[@]} > 0 || REBOOT_REQUIRED == 1 )); then EXIT_CODE=$EX_PARTIAL
    else EXIT_CODE=0; fi
}

write_json_summary() {
    local target="${JSON_FILE:-$JSON_FILE_DEFAULT}" name first=1 w mode
    mkdir -p "$(dirname "$target")"
    if (( REPORT_ONLY == 1 )); then mode="report"
    elif (( DRY_RUN == 1 )); then mode="dry-run"
    else mode="update"; fi
    {
        printf '{\n'
        printf '  "version": "%s",\n' "$(json_escape "$VERSION")"
        printf '  "timestamp": "%s",\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        printf '  "mode": "%s",\n' "$mode"
        printf '  "duration_seconds": %d,\n' "$ELAPSED"
        printf '  "disk_free_before_gb": %d,\n' "$DISK_FREE_BEFORE"
        printf '  "disk_free_after_gb": %d,\n' "$DISK_FREE_AFTER"
        printf '  "health_score": %d,\n' "$HEALTH_SCORE"
        printf '  "reboot_required": %s,\n' "$([[ $REBOOT_REQUIRED -eq 1 ]] && echo true || echo false)"
        printf '  "pending_system_updates": %d,\n' "$PENDING_UPDATES"
        printf '  "exit_code": %d,\n' "$EXIT_CODE"
        printf '  "modules": {\n'
        first=1
        for name in "${MODULE_ORDER[@]}"; do
            (( first == 0 )) && printf ',\n'; first=0
            printf '    "%s": {"status": "%s", "detail": "%s", "duration_seconds": %d}' \
                "$(json_escape "$name")" "$(json_escape "${MODULE_STATUS_MAP[$name]}")" \
                "$(json_escape "${MODULE_DETAIL_MAP[$name]}")" "${TIMINGS[$name]:-0}"
        done
        printf '\n  },\n'
        printf '  "warnings": ['
        first=1
        for w in "${WARNINGS[@]}"; do
            (( first == 0 )) && printf ', '; first=0
            printf '"%s"' "$(json_escape "$w")"
        done
        printf ']\n}\n'
    } >"$target"
    JSON_FILE="$target"
}

calculate_health
compute_exit_code
log "\n${BOLD}${MAGENTA}════════════════════ ÖZET ════════════════════${RESET}"
log "Süre    : ${MIN}dk ${SEC}sn"
if (( DRY_RUN == 1 )); then log "Disk    : ${DISK_FREE_BEFORE} GB (dry-run)"
elif (( REPORT_ONLY == 1 )); then log "Disk    : ${DISK_FREE_AFTER} GB (rapor)"
else
    log "Disk    : ${DISK_FREE_BEFORE} GB → ${DISK_FREE_AFTER} GB"
    (( DISK_DELTA > 0 )) && log "          ${GREEN}+${DISK_DELTA} GB boş alan${RESET}"
    (( DISK_DELTA < 0 )) && log "          ${YELLOW}${DISK_DELTA} GB (indirme/kurulum)${RESET}"
fi
log "Sağlık  : ${HEALTH_SCORE}/100"
(( REBOOT_REQUIRED == 1 )) && log "Yeniden başlatma: ${YELLOW}gerekli${RESET}"

if (( DRY_RUN == 0 && ${#TIMINGS[@]} > 0 )); then
    local_slow=""
    for k in "${!TIMINGS[@]}"; do
        (( ${TIMINGS[$k]} >= 2 )) && local_slow+="${TIMINGS[$k]} $k\n"
    done
    if [[ -n "$local_slow" ]]; then
        log "\n${BOLD}En yavaş modüller:${RESET}"
        while read -r t n; do [[ -n "$n" ]] && log "$(printf '  %3ss  %s' "$t" "$n")"; done < <(printf '%b' "$local_slow" | sort -rn | head -5)
    fi
fi

log ""
log "${GREEN}Güncellendi (${#UPDATED[@]}):${RESET} ${UPDATED[*]:-yok}"
log "${GREEN}Güncel      (${#CURRENT[@]}):${RESET} ${CURRENT[*]:-yok}"
log "${YELLOW}Mevcut      (${#AVAILABLE[@]}):${RESET} ${AVAILABLE[*]:-yok}"
log "${CYAN}Tamamlandı  (${#COMPLETED[@]}):${RESET} ${COMPLETED[*]:-yok}"
log "${YELLOW}Kısmi       (${#PARTIALS[@]}):${RESET} ${PARTIALS[*]:-yok}"
(( REPORT_ONLY == 1 )) && log "${CYAN}Raporlandı  (${#REPORTED[@]}):${RESET} ${REPORTED[*]:-yok}"
(( DRY_RUN == 1 )) && log "${CYAN}Planlandı   (${#PLANNED[@]}):${RESET} ${PLANNED[*]:-yok}"
log "${YELLOW}Atlandı     (${#SKIPPED[@]}):${RESET} ${SKIPPED[*]:-yok}"
log "${RED}Hata        (${#FAILURES[@]}):${RESET} ${FAILURES[*]:-yok}"

if (( ${#WARNINGS[@]} > 0 )); then
    log "\n${YELLOW}Uyarılar (${#WARNINGS[@]}):${RESET}"
    for w in "${WARNINGS[@]}"; do log "  • $w"; done
fi

log "\nLog: $LOG_FILE"
if (( JSON_MODE == 1 )); then
    write_json_summary
    (( JSON_ONLY == 0 )) && log "JSON: $JSON_FILE"
fi

if (( NOTIFY == 1 && DRY_RUN == 0 )) && have osascript; then
    title="macupdate v$VERSION"
    body="Sağlık $HEALTH_SCORE/100 · ${#UPDATED[@]} güncellendi · ${#FAILURES[@]} hata · ${MIN}dk ${SEC}sn"
    osascript -e "display notification \"$body\" with title \"$title\"" >/dev/null 2>&1 || true
fi

if (( JSON_ONLY == 1 )); then cat "$JSON_FILE"; fi

exit "$EXIT_CODE"
