}

[[ -t 1 && "${MACUPDATE_NO_CLEAR:-0}" != "1" ]] && clear
box_border ╔ ╗
box_row "  macupdate v${VERSION}    $(date '+%Y-%m-%d %H:%M')"
box_row "  $(scutil --get ComputerName 2>/dev/null || echo mac)   macOS $(sw_vers -productVersion)   ($(uname -m))"
box_border ╚ ╝

# Ön kontrol
[[ "$(uname -s)" == "Darwin" ]] || { err "Bu script yalnız macOS içindir"; exit "$EX_UNAVAILABLE"; }
if (( DISK_FREE_BEFORE < 10 )); then
    warn "Boş disk alanı düşük: ${DISK_FREE_BEFORE} GB"
fi

groups=()
[[ $DOCTOR_ONLY    -eq 1 ]] && groups+=("doctor")
[[ $RUN_CORE       -eq 1 ]] && groups+=("core")
[[ $RUN_EXTENDED   -eq 1 ]] && groups+=("extended")
[[ $RUN_EDITORS    -eq 1 ]] && groups+=("editors")
[[ $RUN_MAINTENANCE -eq 1 ]] && groups+=("maintenance")
[[ $RUN_DEEP_CLEAN -eq 1 ]] && groups+=("deep-clean")
[[ $RUN_OLLAMA     -eq 1 ]] && groups+=("ollama")
[[ $RUN_REPOS      -eq 1 ]] && groups+=("repos")
[[ $RUN_AUDIT      -eq 1 ]] && groups+=("audit")
[[ $RUN_INVENTORY  -eq 1 ]] && groups+=("inventory")

log "Log    : $LOG_FILE"
log "Disk   : ${DISK_FREE_BEFORE} GB boşta"
log "Modül  : ${groups[*]}${ONLY_MODULE:+ (yalnız: $ONLY_MODULE)}"
[[ $REPORT_ONLY -eq 1 ]] && note "RAPOR MODU — güncelleme yapılmayacak"
[[ $DRY_RUN     -eq 1 ]] && note "DRY-RUN — hiçbir değişiklik yapılmayacak"
[[ $GREEDY      -eq 1 ]] && note "--greedy aktif (excludes: ${GREEDY_EXCLUDE[*]})"
[[ $STALE_LOCK_CLEARED -eq 1 ]] && note "Bayat run.lock otomatik temizlendi"

