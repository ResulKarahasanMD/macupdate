# DEEP CLEAN
# ═════════════════════════════════════════════════════════════════════

# Verilen cache yollarının İÇERİĞİNİ siler. Önce boyutları listeler; dry-run'da
# yalnız gösterir, aksi halde onay ister (tty yoksa --yes olmadan silmez).
clean_cache_paths() {
    local label="$1"; shift
    local -a hits=()
    local p kb total_before=0 total_after=0
    for p in "$@"; do
        [[ -e "$p" ]] || continue
        kb=$(disk_used_kb "$p")
        hits+=("$p")
        total_before=$((total_before + kb))
        log "  $(human_kb "$kb")\t$p"
    done
    (( ${#hits[@]} == 0 )) && { skip_module "$label: temizlenecek yol yok"; return 99; }
    if (( DRY_RUN == 1 )); then
        for p in "${hits[@]}"; do log "${DIM}\$ rm -rf \"$p\"/*${RESET}"; done
        module_planned "~$(human_kb "$total_before") silinecekti (${#hits[@]} yol)"
        return 0
    fi
    confirm "$label: ${#hits[@]} yolun içeriği (~$(human_kb "$total_before")) silinsin mi?" "N" \
        || { skip_module "$label: silinmedi — $CONFIRM_WHY"; return 99; }
    for p in "${hits[@]}"; do
        log "${DIM}\$ rm -rf \"$p\"/*${RESET}"
        rm -rf "${p:?}"/* 2>/dev/null || true
        total_after=$((total_after + $(disk_used_kb "$p")))
    done
    module_updated "$(human_kb "$total_before") → $(human_kb "$total_after") (kurtarılan: $(human_kb $((total_before - total_after))))"
    return 0
}

