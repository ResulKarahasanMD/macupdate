# ── Yardımcı fonksiyonlar ─────────────────────────────────────────────
log() {
    local text="$*" plain="$*" c
    # Renk kodları yalnız ekrana gider; log dosyası düz metin kalır.
    if [[ -n "$RESET" ]]; then
        for c in "$BOLD" "$DIM" "$RESET" "$RED" "$GREEN" "$YELLOW" "$BLUE" "$CYAN" "$MAGENTA"; do
            plain=${plain//"$c"/}
        done
    fi
    printf '%b\n' "$plain" >>"$LOG_FILE"
    (( QUIET == 0 )) && printf '%b\n' "$text"
}
info()  { log "${CYAN}ℹ${RESET}  $*"; }
ok()    { log "${GREEN}✓${RESET}  $*"; }
warn()  { log "${YELLOW}⚠${RESET}  $*"; WARNINGS+=("$*"); }
err()   { log "${RED}✗${RESET}  $*"; }
note()  { log "${CYAN}ℹ${RESET}  $*"; }
step()  { log "\n${BOLD}${BLUE}══▶ $*${RESET}"; }

have()  { command -v "$1" >/dev/null 2>&1; }

module_updated()   { MODULE_STATUS="updated";   MODULE_DETAIL="${1:-}"; }
module_current()   { MODULE_STATUS="current";   MODULE_DETAIL="${1:-}"; }
module_available() { MODULE_STATUS="available"; MODULE_DETAIL="${1:-}"; }
module_completed() { MODULE_STATUS="completed"; MODULE_DETAIL="${1:-}"; }
module_partial()   { MODULE_STATUS="partial";   MODULE_DETAIL="${1:-}"; }
module_failed()    { MODULE_STATUS="failed";    MODULE_DETAIL="${1:-}"; }
module_skipped()   { MODULE_STATUS="skipped";   MODULE_DETAIL="${1:-}"; }
module_reported()  { MODULE_STATUS="reported";  MODULE_DETAIL="${1:-}"; }
module_planned()   { MODULE_STATUS="planned";   MODULE_DETAIL="${1:-}"; }

array_add_unique() {
    local -n __arr="$1"
    local value="$2" existing
    for existing in "${__arr[@]}"; do [[ "$existing" == "$value" ]] && return 0; done
    __arr+=("$value")
}

record_module_result() {
    local name="$1" status="$2" detail="${3:-}"
    MODULE_STATUS_MAP["$name"]="$status"
    MODULE_DETAIL_MAP["$name"]="$detail"
    array_add_unique MODULE_ORDER "$name"
    case "$status" in
        updated)   array_add_unique UPDATED "$name" ;;
        current)   array_add_unique CURRENT "$name" ;;
        available) array_add_unique AVAILABLE "$name" ;;
        completed) array_add_unique COMPLETED "$name" ;;
        partial)   array_add_unique PARTIALS "$name" ;;
        failed)    array_add_unique FAILURES "$name" ;;
        skipped)   array_add_unique SKIPPED "$name" ;;
        reported)  array_add_unique REPORTED "$name" ;;
        planned)   array_add_unique PLANNED "$name" ;;
    esac
}

sh_run() {
    log "${DIM}\$ $*${RESET}"
    [[ $DRY_RUN -eq 1 ]] && return 0
    if (( QUIET == 1 )); then
        "$@" >>"$LOG_FILE" 2>&1
        return $?
    fi
    "$@" 2>&1 | tee -a "$LOG_FILE"
    return "${PIPESTATUS[0]}"
}

sh_run_quiet() {
    local filter="$1"; shift
    local tmp rc
    tmp=$(mktemp "${TMPDIR:-/tmp}/macupdate.XXXXXX") || return 1
    log "${DIM}\$ $*${RESET}"
    if [[ $DRY_RUN -eq 1 ]]; then rm -f "$tmp"; return 0; fi
    "$@" >"$tmp" 2>&1; rc=$?
    cat "$tmp" >>"$LOG_FILE"
    if (( QUIET == 0 )); then grep -E "$filter" "$tmp" | tail -30 || true; fi
    rm -f "$tmp"
    return $rc
}

capture_logged() {
    local __var="$1"; shift
    local tmp rc payload
    tmp=$(mktemp "${TMPDIR:-/tmp}/macupdate.XXXXXX") || return 1
    "$@" >"$tmp" 2>&1; rc=$?
    payload=$(cat "$tmp")
    cat "$tmp" >>"$LOG_FILE"
    rm -f "$tmp"
    printf -v "$__var" '%s' "$payload"
    return $rc
}

# Salt-okunur sorgu: yalnız stdout değişkene alınır (sayım/parse için),
# stderr (uyarılar) yalnız loga gider. Dry-run'da da çalışır.
capture_stdout() {
    local __var="$1"; shift
    local tmp rc payload
    tmp=$(mktemp "${TMPDIR:-/tmp}/macupdate.XXXXXX") || return 1
    "$@" >"$tmp" 2>>"$LOG_FILE"; rc=$?
    payload=$(cat "$tmp")
    [[ -n "$payload" ]] && printf '%s\n' "$payload" >>"$LOG_FILE"
    rm -f "$tmp"
    printf -v "$__var" '%s' "$payload"
    return $rc
}

# Sistemi değiştiren komut: "$ …" satırını loglar, dry-run'da ÇALIŞTIRMAZ,
# aksi halde stdout+stderr'i değişkene alır.
run_capture() {
    local __var="$1"; shift
    log "${DIM}\$ $*${RESET}"
    if (( DRY_RUN == 1 )); then printf -v "$__var" '%s' ""; return 0; fi
    capture_logged "$__var" "$@"
}

# Harici bağımlılıksız zaman aşımı; aşımda 124 döner.
run_with_timeout() {
    local timeout_s="$1"; shift
    log "${DIM}\$ $* (zaman aşımı ${timeout_s}s)${RESET}"
    (( DRY_RUN == 1 )) && return 0
    "$@" >>"$LOG_FILE" 2>&1 &
    local pid=$! i=0 rc=0
    while kill -0 "$pid" 2>/dev/null; do
        if (( i >= timeout_s )); then
            kill -TERM "$pid" 2>/dev/null || true
            sleep 1
            kill -KILL "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 124
        fi
        sleep 1
        ((i+=1))
    done
    wait "$pid" || rc=$?
    return "$rc"
}

safe_rm() {
    log "${DIM}\$ rm -rf $*${RESET}"
    [[ $DRY_RUN -eq 1 ]] && return 0
    rm -rf "$@" 2>/dev/null
    return 0
}

# Gerekçe yalnız durum ayrıntısına yazılır; run_module'ün "atlandı" satırı
# onu zaten gösterir (ayrıca note basmak aynı cümleyi iki kez yazdırıyordu).
skip_module() {
    module_skipped "$1"
    return 99
}

# confirm MESAJ [Y|N] — evetse 0. Hayırsa nedeni CONFIRM_WHY'a yazar; atlama
# gerekçesi "tty yok", "yanıt yok" ve "hayır" durumlarını karıştırmasın.
confirm() {
    local msg="$1"; local default="${2:-N}"
    local prompt="[e/H]" ans rc
    [[ "$default" == "Y" ]] && prompt="[E/h]"
    CONFIRM_WHY=""
    (( ASSUME_YES == 1 )) && return 0
    if (( DRY_RUN == 1 )); then
        log "${DIM}[dry-run: $msg $prompt → otomatik iptal]${RESET}"
        CONFIRM_WHY="dry-run"; return 1
    fi
    if [[ ! -t 0 ]]; then
        [[ "$default" =~ ^[YyEe]$ ]] && return 0
        CONFIRM_WHY="tty yok, --yes gerekir"; return 1
    fi
    read -r -t "$CONFIRM_TIMEOUT" -p "$msg $prompt " ans; rc=$?
    if (( rc > 128 )); then
        printf '\n' >&2
        ans="$default"; CONFIRM_WHY="$CONFIRM_TIMEOUT sn içinde yanıt yok"
    else
        [[ -z "$ans" ]] && ans="$default"
        CONFIRM_WHY="yanıt: hayır"
    fi
    [[ -e "$LOG_FILE" ]] && printf '? %s %s → %s\n' "$msg" "$prompt" "$ans" >>"$LOG_FILE"
    [[ "$ans" =~ ^[EeYy]$ ]] && { CONFIRM_WHY=""; return 0; }
    return 1
}

only_has() { [[ ",$ONLY_MODULE," == *",$1,"* ]]; }
module_selected() { [[ -z "$ONLY_MODULE" ]] || only_has "$1"; }

run_module() {
    local name="$1" fn="$2" start elapsed rc status detail
    MODULE_STATUS=""
    MODULE_DETAIL=""
    module_selected "$name" || return 0
    step "[$name]"
    start=$(date +%s)

    if (( REPORT_ONLY == 1 )); then
        if declare -f "${fn}_report" >/dev/null; then
            "${fn}_report"; rc=$?
            [[ -z "$MODULE_STATUS" ]] && {
                (( rc == 0 )) && module_reported "raporlandı" || module_failed "rapor sorgusu başarısız (rc=$rc)"
            }
        else
            module_skipped "rapor desteği yok"
            note "Rapor modu desteklenmiyor"
            rc=99
        fi
    else
        "$fn"; rc=$?
        if [[ -z "$MODULE_STATUS" ]]; then
            case $rc in
                0)  module_completed "tamamlandı" ;;
                99) module_skipped "atlandı" ;;
                *)  module_failed "rc=$rc" ;;
            esac
        elif (( rc != 0 && rc != 99 )) && [[ "$MODULE_STATUS" != "partial" && "$MODULE_STATUS" != "failed" ]]; then
            module_failed "${MODULE_DETAIL:-rc=$rc}"
        fi
        # Dry-run'da hiçbir şey değişmediği için "güncellendi/tamam" yanıltıcıdır.
        if (( DRY_RUN == 1 )) && [[ "$MODULE_STATUS" == "updated" || "$MODULE_STATUS" == "completed" ]]; then
            module_planned "dry-run${MODULE_DETAIL:+ — $MODULE_DETAIL}"
        fi
    fi

    elapsed=$(( $(date +%s) - start ))
    TIMINGS["$name"]=$elapsed
    status="$MODULE_STATUS"; detail="$MODULE_DETAIL"
    record_module_result "$name" "$status" "$detail"
    case "$status" in
        updated)   ok "$name güncellendi (${elapsed}s)${detail:+ — $detail}" ;;
        current)   ok "$name güncel (${elapsed}s)${detail:+ — $detail}" ;;
        available) log "${YELLOW}↑${RESET}  $name güncelleme mevcut (${elapsed}s)${detail:+ — $detail}" ;;
        completed) ok "$name tamam (${elapsed}s)${detail:+ — $detail}" ;;
        partial)   log "${YELLOW}◐${RESET}  $name kısmi (${elapsed}s)${detail:+ — $detail}" ;;
        failed)    err "$name hata (${elapsed}s)${detail:+ — $detail}" ;;
        skipped)   log "${YELLOW}↯${RESET}  $name atlandı (${elapsed}s)${detail:+ — $detail}" ;;
        reported)  log "${CYAN}≡${RESET}  $name raporlandı (${elapsed}s)${detail:+ — $detail}" ;;
        planned)   log "${CYAN}○${RESET}  $name planlandı (${elapsed}s)${detail:+ — $detail}" ;;
    esac
    return 0
}

disk_free_gb() { df -g / | awk 'NR==2 {print $4}'; }
disk_used_kb() { [[ -e "$1" ]] && du -sk "$1" 2>/dev/null | awk '{print $1}' || echo 0; }
human_kb() {
    local kb=${1:-0}
    if (( kb >= 1048576 )); then awk -v n="$kb" 'BEGIN{printf "%.2f GB",n/1048576}'
    elif (( kb >= 1024 )); then awk -v n="$kb" 'BEGIN{printf "%.1f MB",n/1024}'
    else printf "%d KB" "$kb"
    fi
}
line_count() { awk 'NF{n++} END{print n+0}' <<<"${1:-}"; }
# join_list a b c → "a, b, c" (kısmi durum gerekçelerinde başarısız komut adları)
join_list() { local out; printf -v out '%s, ' "$@"; printf '%s' "${out%, }"; }
# resolve_path YOL — symlink'leri çözülmüş gerçek yol (çözülemezse olduğu gibi)
resolve_path() { realpath "$1" 2>/dev/null || printf '%s' "$1"; }

# JSON nesnesinin üst düzey anahtarları (satır başına bir tane)
json_keys() {
    local data="${1:-}"
    [[ -z "$data" ]] && return 0
    if have python3; then
        python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
if isinstance(d,dict):
    print("\n".join(d))' <<<"$data" 2>/dev/null
    else
        grep -oE '^  "[^"]+"[[:space:]]*:' <<<"$data" | sed -E 's/^  "([^"]+)".*/\1/' || true
    fi
}

# `npm outdated -g --json` → eski paket adları. Volta altında node imajının
# paketlediği npm/corepack `npm update -g` ile güncellenemez; sayılmaz.
npm_outdated_names() {
    local names
    names=$(json_keys "${1:-}")
    if have volta; then
        names=$(grep -vxE 'npm|corepack' <<<"$names" || true)
    fi
    printf '%s' "$names"
}

# `gem outdated` stdout'unda yalnız "ad (eski < yeni)" satırlarının adları
gem_outdated_names() {
    awk '/^[A-Za-z0-9_.-]+ \([^)]* < [^)]*\)$/ {print $1}' <<<"${1:-}"
}

# gem_user_outdated OUTDATED SHIPPED — Ruby ile gelmeyen eski gem adları
gem_user_outdated() {
    gem_outdated_names "$1" | grep -vxF -f <(printf '%s\n' "${2:-}") || true
}

mas_id_skipped() {
    local s
    for s in "${MAS_SKIP_IDS[@]}"; do [[ "$s" == "$1" ]] && return 0; done
    return 1
}

# ── Modül kaydı yardımcıları ──────────────────────────────────────────
registry_group_of() {
    local entry g n rest
    for entry in "${MODULE_REGISTRY[@]}"; do
        IFS=: read -r g n rest <<<"$entry"
        [[ "$n" == "$1" ]] && { printf '%s' "$g"; return 0; }
    done
    return 1
}

enable_group() {
    case "$1" in
        doctor)     DOCTOR_ONLY=1 ;;
        core)       RUN_CORE=1 ;;
        extended)   RUN_EXTENDED=1 ;;
        editors)    RUN_EDITORS=1 ;;
        deep-clean) RUN_DEEP_CLEAN=1 ;;
        ollama)     RUN_OLLAMA=1 ;;
        repos)      RUN_REPOS=1 ;;
        audit)      RUN_AUDIT=1 ;;
        inventory)  RUN_INVENTORY=1 ;;
    esac
}

group_enabled() {
    case "$1" in
        doctor)     (( DOCTOR_ONLY == 1 )) ;;
        core)       (( RUN_CORE == 1 )) ;;
        extended)   (( RUN_EXTENDED == 1 )) ;;
        editors)    (( RUN_EDITORS == 1 )) ;;
        deep-clean) (( RUN_DEEP_CLEAN == 1 )) ;;
        ollama)     (( RUN_OLLAMA == 1 )) ;;
        repos)      (( RUN_REPOS == 1 )) ;;
        audit)      (( RUN_AUDIT == 1 )) ;;
        inventory)  (( RUN_INVENTORY == 1 )) ;;
        *)          return 1 ;;
    esac
}

list_modules() {
    local grp entry g n rest
    for grp in "${GROUP_ORDER[@]}"; do
        printf '%s:\n' "$grp"
        for entry in "${MODULE_REGISTRY[@]}"; do
            IFS=: read -r g n rest <<<"$entry"
            [[ "$g" == "$grp" ]] && printf '  %s\n' "$n"
        done
    done
}

usage_error() {
    echo "$1" >&2
    echo "Yardım: $0 --help" >&2
    exit "$EX_USAGE"
}

rotate_logs() {
    (( LOG_ROTATE == 1 )) || return 0
    (( DRY_RUN == 1 )) && return 0    # dry-run hiçbir şey silmez; eski günlükler de kalır
    find "$LOG_DIR" -maxdepth 1 -type f \( -name 'macupdate-*.log' -o -name 'macupdate-*.json' \) \
        -mtime "+$LOG_MAX_DAYS" -delete 2>/dev/null || true
    local files extra
    mapfile -t files < <(find "$LOG_DIR" -maxdepth 1 -type f -name 'macupdate-*.log' -print 2>/dev/null | sort -r)
    extra=$(( ${#files[@]} - LOG_MAX_FILES ))
    if (( extra > 0 )); then
        printf '%s\n' "${files[@]:LOG_MAX_FILES}" | while IFS= read -r f; do
            rm -f "$f" "${f%.log}.json" 2>/dev/null || true
        done
    fi
}

# ── Argüman parse ─────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)       DRY_RUN=1 ;;
        --report)        REPORT_ONLY=1 ;;
        --doctor)        DOCTOR_ONLY=1; RUN_CORE=0 ;;
        --json)          JSON_MODE=1 ;;
        --json-only)     JSON_MODE=1; JSON_ONLY=1; QUIET=1 ;;
        --json-file)     [[ -n "${2:-}" && "$2" != -* ]] || usage_error "--json-file yol ister"; JSON_MODE=1; JSON_FILE="$2"; shift ;;
        --quiet)         QUIET=1 ;;
        --notify)        NOTIFY=1 ;;
        --no-notify)     NOTIFY=0 ;;
        --init-config)   INIT_CONFIG=1 ;;
        --unlock)        UNLOCK_ONLY=1 ;;
        --no-log-rotate) LOG_ROTATE=0 ;;
        --greedy)        GREEDY=1 ;;
        --skip-system)   SKIP_SYSTEM=1 ;;
        --skip-docker)   SKIP_DOCKER=1 ;;
        --skip-cache)    SKIP_CACHE=1 ;;
        --skip-xcode)    SKIP_XCODE=1 ;;
        --install-system-updates) INSTALL_SYSTEM_UPDATES=1 ;;
        --docker-prune) DOCKER_PRUNE=1 ;;
        --docker-prune-volumes) DOCKER_PRUNE=1; DOCKER_PRUNE_VOLUMES=1 ;;
        --xcode-clean) XCODE_CLEAN=1 ;;
        --go-clean) GO_CLEAN=1 ;;
        --aggressive-clean) AGGRESSIVE_CLEAN=1 ;;
        --extended)      RUN_EXTENDED=1 ;;
        --editors)       RUN_EDITORS=1 ;;
        --maintenance)   RUN_MAINTENANCE=1 ;;
        --deep-clean)    RUN_DEEP_CLEAN=1 ;;
        --ollama-update) RUN_OLLAMA=1 ;;
        --repos)
            RUN_REPOS=1
            if [[ -n "${2:-}" && "$2" != -* ]]; then REPOS_DIR="$2"; shift; fi ;;
        --audit)         RUN_AUDIT=1 ;;
        --inventory)
            RUN_INVENTORY=1
            if [[ -n "${2:-}" && "$2" != -* ]]; then INVENTORY_DIR="$2"; shift; fi ;;
        --all) RUN_EXTENDED=1; RUN_EDITORS=1; RUN_MAINTENANCE=1 ;;
        --only) [[ -n "${2:-}" && "$2" != -* ]] || usage_error "--only modül adı ister (bkz. --list-modules)"; ONLY_MODULE="$2"; shift ;;
        --list-modules)  LIST_MODULES=1 ;;
        -y|--yes) ASSUME_YES=1 ;;
        --empty-trash|--no-empty-trash)
            echo "Not: $1 v6'da etkisiz (macupdate çöp kutusunu boşaltmaz)" >&2 ;;
        -v|--version) echo "macupdate $VERSION"; exit 0 ;;
        -h|--help)
            sed -n '/^# macupdate —/,/^# -\{10,\}/p' "$0" | sed 's/^# \{0,1\}//; /^-\{10,\}/d'
            exit 0 ;;
        *) usage_error "Bilinmeyen parametre: $1" ;;
    esac
    shift
done

if (( LIST_MODULES == 1 )); then list_modules; exit 0; fi

# --only doğrula; seçilen modülün grubu açık değilse kendiliğinden aç
if [[ -n "$ONLY_MODULE" ]]; then
    ONLY_MODULE="${ONLY_MODULE// /}"
    IFS=, read -r -a _only_list <<<"$ONLY_MODULE"
    for _m in "${_only_list[@]}"; do
        [[ -z "$_m" ]] && continue
        _g=$(registry_group_of "$_m") || usage_error "Bilinmeyen modül: $_m (geçerli adlar için --list-modules)"
        enable_group "$_g"
    done
    unset _only_list _m _g
fi

mkdir -p "$LOG_DIR"

init_config() {
    local dir
    dir=$(dirname "$CONFIG_FILE")
    mkdir -p "$dir"
    if [[ -e "$CONFIG_FILE" ]] && ! confirm "$CONFIG_FILE üzerine yazılsın mı?" "N"; then
        echo "İptal edildi: $CONFIG_FILE"
        exit 0
    fi
    cat >"$CONFIG_FILE" <<'CFG'
# macupdate v6 yapılandırması
GREEDY=0
NOTIFY=0
LOG_MAX_DAYS=30
LOG_MAX_FILES=100
# UV_PRUNE_TIMEOUT=60
# GREEDY_EXCLUDE+=(ornek-cask)
# MAS_SKIP_IDS+=(1569813296)
CFG
    chmod 600 "$CONFIG_FILE"
    echo "Oluşturuldu: $CONFIG_FILE"
    exit 0
}

[[ $INIT_CONFIG -eq 1 ]] && init_config

LOCK_DIR="$LOG_DIR/run.lock"
LOCK_PID_FILE="$LOCK_DIR/pid"
LOCK_STARTED_FILE="$LOCK_DIR/started"
LOCK_HOST_FILE="$LOCK_DIR/host"
LOCK_COMMAND_FILE="$LOCK_DIR/command"
LOCK_VERSION_FILE="$LOCK_DIR/version"
LOCK_TOKEN_FILE="$LOCK_DIR/token"
SUDO_KEEPALIVE_PID=""
STALE_LOCK_CLEARED=0
LOCK_TOKEN="${RANDOM:-0}-$$-$(date +%s)"

write_lock_metadata() {
    printf '%s\n' "$$" >"$LOCK_PID_FILE"
    date '+%Y-%m-%d %H:%M:%S %z' >"$LOCK_STARTED_FILE"
    hostname >"$LOCK_HOST_FILE" 2>/dev/null || true
    ps -p $$ -o command= >"$LOCK_COMMAND_FILE" 2>/dev/null || printf '%s\n' "$0" >"$LOCK_COMMAND_FILE"
    printf '%s\n' "$VERSION" >"$LOCK_VERSION_FILE"
    printf '%s\n' "$LOCK_TOKEN" >"$LOCK_TOKEN_FILE"
}

lock_is_live() {
    local pid cmd host current_host
    [[ -r "$LOCK_PID_FILE" ]] || return 1
    read -r pid <"$LOCK_PID_FILE" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    host=""; [[ -r "$LOCK_HOST_FILE" ]] && read -r host <"$LOCK_HOST_FILE" || true
    current_host=$(hostname 2>/dev/null || true)
    [[ -z "$host" || -z "$current_host" || "$host" == "$current_host" ]] || return 1
    cmd=$(ps -p "$pid" -o command= 2>/dev/null || true)
    [[ "$cmd" == *macupdate* ]]
}

acquire_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then write_lock_metadata; return 0; fi
    if lock_is_live; then
        local old_pid old_started=""
        read -r old_pid <"$LOCK_PID_FILE"
        [[ -r "$LOCK_STARTED_FILE" ]] && read -r old_started <"$LOCK_STARTED_FILE" || true
        echo "Başka bir macupdate çalışıyor: PID $old_pid${old_started:+, başlangıç $old_started}" >&2
        return "$EX_LOCKED"
    fi
    rm -rf "$LOCK_DIR" 2>/dev/null || { echo "Bayat kilit temizlenemedi: $LOCK_DIR" >&2; return "$EX_LOCKED"; }
    mkdir "$LOCK_DIR" 2>/dev/null || { echo "Kilit yeniden oluşturulamadı: $LOCK_DIR" >&2; return "$EX_LOCKED"; }
    write_lock_metadata
    STALE_LOCK_CLEARED=1
}

unlock_stale() {
    if [[ ! -e "$LOCK_DIR" ]]; then echo "Kilit yok: $LOCK_DIR"; exit 0; fi
    if lock_is_live; then
        local p; read -r p <"$LOCK_PID_FILE"
        echo "Kilit canlı bir macupdate sürecine ait (PID $p); silinmedi." >&2
        exit "$EX_LOCKED"
    fi
    rm -rf "$LOCK_DIR" && echo "Bayat kilit silindi: $LOCK_DIR"
    exit 0
}

cleanup_all() {
    local rc=$? token=""
    trap - EXIT INT TERM HUP
    if [[ -n "${SUDO_KEEPALIVE_PID:-}" ]]; then
        kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    fi
    [[ -r "$LOCK_TOKEN_FILE" ]] && read -r token <"$LOCK_TOKEN_FILE" || true
    if [[ -d "$LOCK_DIR" && ( -z "$token" || "$token" == "$LOCK_TOKEN" ) ]]; then
        rm -rf "$LOCK_DIR" 2>/dev/null || true
    fi
    exit "$rc"
}

[[ $UNLOCK_ONLY -eq 1 ]] && unlock_stale
acquire_lock || exit $?
trap cleanup_all EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# Log yalnız kilit alındıktan sonra oluşturulur (kilide takılan çalıştırma
# boş log bırakmasın); döndürme de kilit altında yapılır.
