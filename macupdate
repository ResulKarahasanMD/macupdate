# softwareupdate --list ekran çıktısı: sabit başlık satırları ve boş satırlar
# atılır (tam çıktı logda kalır).
softwareupdate_filter() {
    grep -vE '^(Software Update Tool|Finding available software)?[[:space:]]*$' <<<"${1:-}" || true
}

mod_softwareupdate() {
    [[ $SKIP_SYSTEM -eq 1 ]] && { skip_module "--skip-system"; return 99; }
    local before after count rc has_restart remaining
    log "${DIM}\$ softwareupdate --list${RESET}"
    capture_logged before softwareupdate --list; rc=$?
    (( QUIET == 0 )) && softwareupdate_filter "$before"
    (( rc != 0 )) && { module_failed "softwareupdate sorgusu başarısız (rc=$rc)"; return $rc; }
    count=$(grep -c '^\* Label:' <<<"$before" || true)
    PENDING_UPDATES=$count
    (( count == 0 )) && { module_current "sistem güncel"; return 0; }
    has_restart=0; grep -q 'Action: restart' <<<"$before" && has_restart=1

    if (( INSTALL_SYSTEM_UPDATES == 0 )); then
        module_available "$count sistem güncellemesi bekliyor"
        note "Yüklemek için: ${BOLD}$0 --install-system-updates${RESET}"
        return 0
    fi

    if (( DRY_RUN == 1 )); then
        sh_run sudo softwareupdate --install --all --verbose
        module_available "$count sistem güncellemesi kurulacaktı"
        return 0
    fi
    warn "Sistem güncellemeleri kurulacak; yeniden başlatma gerekebilir"
    sh_run sudo softwareupdate --install --all --verbose; rc=$?
    (( rc != 0 )) && { module_failed "kurulum başarısız (rc=$rc)"; return $rc; }

    capture_logged after softwareupdate --list || true
    remaining=$(grep -c '^\* Label:' <<<"$after" || true)
    if (( remaining == 0 )); then
        module_updated "$count güncelleme kuruldu"
    elif grep -q 'Action: restart' <<<"$after" || (( has_restart == 1 )); then
        REBOOT_REQUIRED=1
        module_partial "güncelleme hazırlandı; yeniden başlatma sonrası doğrulanacak"
    else
        module_partial "$remaining güncelleme hâlâ listeleniyor"
    fi
    return 0
}

mod_mas() {
    have mas || { skip_module "mas yok (brew install mas)"; return 99; }
    local before after ids id rc out remaining=0 updated=0 skipped_ids=0 skip_note=""
    local -a targets=()
    log "${DIM}\$ mas outdated${RESET}"
    capture_stdout before mas outdated; rc=$?
    (( QUIET == 0 )) && [[ -n "$before" ]] && printf '%s\n' "$before"
    (( rc != 0 )) && { module_failed "mas outdated başarısız (rc=$rc)"; return $rc; }
    ids=$(awk '/^[[:space:]]*[0-9]+[[:space:]]/ {print $1}' <<<"$before")
    [[ -z "$ids" ]] && { module_current "App Store güncellemesi yok"; return 0; }

    while read -r id; do
        [[ -z "$id" ]] && continue
        if mas_id_skipped "$id"; then
            note "MAS ADAM ID $id config ile atlandı"
            ((skipped_ids+=1)); continue
        fi
        targets+=("$id")
    done <<<"$ids"
    (( skipped_ids > 0 )) && skip_note="; $skipped_ids uygulama config ile atlandı"
    (( ${#targets[@]} == 0 )) && { module_current "güncelleme yok${skip_note}"; return 0; }

    if (( DRY_RUN == 1 )); then
        for id in "${targets[@]}"; do log "${DIM}\$ mas upgrade $id${RESET}"; done
        module_available "${#targets[@]} uygulama güncellenecekti${skip_note}"
        return 0
    fi

    for id in "${targets[@]}"; do
        run_capture out mas upgrade "$id" || true
        (( QUIET == 0 )) && [[ -n "$out" ]] && printf '%s\n' "$out"
    done

    # mas çıkış koduna güvenme; listeyi yeniden sorgula
    capture_stdout after mas outdated || true
    for id in "${targets[@]}"; do
        grep -qE "^[[:space:]]*${id}[[:space:]]" <<<"$after" && ((remaining+=1))
    done
    updated=$(( ${#targets[@]} - remaining ))

    if (( remaining == 0 )); then
        module_updated "$updated uygulama güncellendi${skip_note}"
    elif (( updated > 0 )); then
        warn "$remaining App Store uygulaması güncellenemedi; App Store'dan elle kontrol edin"
        module_partial "$updated güncellendi, $remaining kaldı${skip_note}"
    else
        warn "$remaining App Store uygulaması mas ile indirilemedi; App Store'dan elle kontrol edin"
        module_partial "$remaining uygulama bekliyor${skip_note}"
    fi
    return 0
}

# brew_outdated VAR formula|cask [PINNED] — stdout'tan eski paket adları
# (PINNED satır listesindeki formula'lar hariç)
brew_outdated() {
    local __names="" __pinned="${3:-}"
    if [[ "$2" == cask ]]; then
        if (( GREEDY == 1 )); then capture_stdout __names brew outdated --cask --greedy --quiet || true
        else capture_stdout __names brew outdated --cask --quiet || true; fi
    else
        capture_stdout __names brew outdated --formula --quiet || true
        if [[ -n "$__pinned" && -n "$__names" ]]; then
            __names=$(grep -vxF -f <(printf '%s\n' "$__pinned") <<<"$__names" || true)
        fi
    fi
    printf -v "$1" '%s' "$__names"
}

mod_brew() {
    have brew || { skip_module "brew yok"; return 99; }
    local formulas_before casks_before formulas_after casks_after doctor_out doctor_rc
    local before_count after_count updated_count=0 failed=0 doctor_note="" pinned=""

    sh_run brew update || failed=1
    capture_stdout pinned brew list --pinned || true
    [[ -n "$pinned" ]] && note "Sabitlenmiş (pinned) formula'lar sayılmaz: $(paste -sd' ' - <<<"$pinned")"

    brew_outdated formulas_before formula "$pinned"
    brew_outdated casks_before cask
    before_count=$(( $(line_count "$formulas_before") + $(line_count "$casks_before") ))
    if (( before_count > 0 && QUIET == 0 )); then
        printf '%s\n' "$formulas_before" "$casks_before" | awk 'NF' | sed 's/^/  ↑ /'
    fi

    sh_run brew upgrade || failed=1

    if (( GREEDY == 1 )); then
        local exclude_pattern id
        local -a cask_array=()
        exclude_pattern=$(IFS='|'; echo "${GREEDY_EXCLUDE[*]}")
        while IFS= read -r id; do
            [[ -n "$id" ]] && cask_array+=("$id")
        done < <(grep -vE "^($exclude_pattern)$" <<<"$casks_before" || true)
        if (( ${#cask_array[@]} > 0 )); then
            sh_run brew upgrade --cask "${cask_array[@]}" || failed=1
        else
            note "--greedy: güncellenecek cask yok"
        fi
    fi

    if (( AGGRESSIVE_CLEAN == 1 )); then
        sh_run brew cleanup --prune=all || failed=1
        sh_run brew autoremove || failed=1
    else
        sh_run brew cleanup || failed=1
        local auto_out
        auto_out=$(brew autoremove --dry-run 2>/dev/null || true)
        [[ -n "$auto_out" ]] && note "brew autoremove adayları silinmedi; --aggressive-clean ile uygulanır"
    fi

    # brew doctor salt-okunur; uyarısı bilgi amaçlıdır, durumu etkilemez
    log "${DIM}\$ brew doctor${RESET}"
    capture_logged doctor_out brew doctor; doctor_rc=$?
    if (( doctor_rc != 0 )); then
        (( QUIET == 0 )) && printf '%s\n' "$doctor_out"
        warn "brew doctor uyarı verdi (durumu etkilemez; ayrıntı logda)"
        doctor_note="; doctor uyarısı var"
    fi

    if (( DRY_RUN == 1 )); then
        if (( before_count > 0 )); then module_available "$before_count paket güncellenecekti${doctor_note}"
        else module_current "formula ve cask'ler güncel${doctor_note}"; fi
        return 0
    fi

    brew_outdated formulas_after formula "$pinned"
    brew_outdated casks_after cask
    after_count=$(( $(line_count "$formulas_after") + $(line_count "$casks_after") ))
    (( before_count > after_count )) && updated_count=$((before_count - after_count))

    if (( failed == 1 )); then
        module_partial "bazı Homebrew alt komutları başarısız; $updated_count güncellendi, $after_count kaldı"
    elif (( after_count > 0 )); then
        module_partial "$updated_count güncellendi, $after_count paket kaldı: $(printf '%s\n' "$formulas_after" "$casks_after" | awk 'NF' | paste -sd' ' -)"
    elif (( updated_count > 0 )); then
        module_updated "$updated_count paket güncellendi${doctor_note}"
    else
        module_current "formula ve cask'ler güncel${doctor_note}"
    fi
    return 0
}

# Volta ile kurulan paketler (ad@sürüm); npm outdated -g bunları görmez.
volta_packages() {
    have volta || return 0
    volta list all --format plain 2>/dev/null | awk '$1=="package" {print $2}' | sort -u
}

# volta_pending SPECS — yeni sürümü olan volta paketleri: "ad<TAB>kurulu<TAB>son".
# volta `npm update -g`'yi her pakete `npm update --global <ad>` olarak uygular
# ve sürüm aynı olsa da paketi yeniden kurar (npm REPLACE); allowScripts
# uyarıları her koşuda yeniden çıkar. Bu yüzden yalnız `npm view` ile yeni
# sürümü görülen paket güncellenir. Sorgu başarısızsa son sürüm "?" yazılır ve
# paket yine güncellenir (eski davranıştan geri kalmasın).
volta_pending() {
    local spec name cur latest
    while IFS= read -r spec; do
        [[ -z "$spec" ]] && continue
        name="${spec%@*}"; cur="${spec##*@}"
        capture_stdout latest npm view "$name" version || latest=""
        latest=$(tail -n 1 <<<"$latest" | tr -d '[:space:]')
        [[ "$latest" == "$cur" ]] && continue
        printf '%s\t%s\t%s\n' "$name" "$cur" "${latest:-?}"
    done <<<"${1:-}"
}

# volta_pending çıktısı → "ad kurulu → son, …"
volta_pending_text() {
    awk -F'\t' 'NF {printf "%s%s %s → %s", (n++ ? ", " : ""), $1, $2, $3}' <<<"${1:-}"
}

mod_node() {
    local did=0 changed=0 rc out skip_npm=0 vname
    local npm_before npm_after names_before names_after="" before_n=0 after_n=0 blocked_pkgs=""
    local volta_before="" volta_after="" volta_changed="" volta_todo="" volta_n=0
    local -a reasons=() npm_cmd=(npm update -g) failed_cmds=()
    if have npm; then
        did=1
        capture_stdout npm_before npm outdated -g --json || true
        names_before=$(npm_outdated_names "$npm_before")
        before_n=$(line_count "$names_before")
        names_after="$names_before"; after_n=$before_n
        have volta && json_keys "$npm_before" | grep -qx npm && \
            note "volta: paketlenmiş npm 'npm update -g' ile güncellenmez (gerekirse: volta install npm@latest); sayılmadı"
        volta_before=$(volta_packages)
        if have volta; then
            volta_todo=$(volta_pending "$volta_before")
            volta_n=$(line_count "$volta_todo")
            if (( volta_n == 0 )); then
                skip_npm=1
                [[ -n "$volta_before" ]] && note "volta paketleri güncel, yeniden kurulmadı: $(paste -sd' ' - <<<"$volta_before")"
            else
                while IFS=$'\t' read -r vname _; do npm_cmd+=("$vname"); done <<<"$volta_todo"
                note "volta paketlerinde yeni sürüm: $(volta_pending_text "$volta_todo")"
            fi
        fi

        (( skip_npm == 0 )) && { run_capture out "${npm_cmd[@]}"; rc=$?; }
        if (( DRY_RUN == 0 && skip_npm == 0 )); then
            if (( QUIET == 0 )); then
                grep -E '^(added|removed|changed|npm warn (install-scripts|allow-scripts)|npm ERR!)' <<<"$out" | tail -30 || true
            fi
            blocked_pkgs=$(sed -nE 's/^npm warn (allow-scripts|install-scripts)[[:space:]]+([^[:space:]]+@[^[:space:]]+) \(.*/\2/p' <<<"$out" | sort -u | paste -sd' ' -)
            (( rc != 0 )) && { warn "npm update -g kısmi hata (rc=$rc)"; failed_cmds+=("npm update -g"); }
            capture_stdout npm_after npm outdated -g --json || true
            names_after=$(npm_outdated_names "$npm_after")
            after_n=$(line_count "$names_after")
            (( before_n > after_n )) && changed=$((before_n - after_n))
            volta_after=$(volta_packages)
            if [[ -n "$volta_after" ]]; then
                if [[ -n "$volta_before" ]]; then
                    volta_changed=$(grep -vxF -f <(printf '%s\n' "$volta_before") <<<"$volta_after" || true)
                else
                    volta_changed="$volta_after"
                fi
                if [[ -n "$volta_changed" ]]; then
                    changed=$((changed + $(line_count "$volta_changed")))
                    note "volta paketleri güncellendi: $(paste -sd' ' - <<<"$volta_changed")"
                fi
            fi
        fi
    fi
    if have pnpm; then
        did=1
        local pnpm_ls
        capture_stdout pnpm_ls pnpm ls -g --depth=0 || true
        if [[ -z "$pnpm_ls" ]] || grep -q 'No global packages' <<<"$pnpm_ls"; then
            note "pnpm: global paket yok, güncelleme atlandı"
        else
            run_capture out pnpm update -g; rc=$?
            if (( rc != 0 )); then
                if grep -q 'not in PATH' <<<"$out"; then
                    warn "pnpm global bin dizini PATH'te değil ('pnpm setup' çalıştır)"
                else
                    warn "pnpm global güncelleme başarısız (rc=$rc)"
                fi
                failed_cmds+=("pnpm update -g")
            fi
        fi
    fi
    if have yarn; then
        did=1
        local yver
        yver=$(yarn --version 2>/dev/null || echo "?")
        if [[ "$yver" == 1.* ]]; then
            sh_run yarn global upgrade || failed_cmds+=("yarn global upgrade")
        else
            note "yarn $yver: global paket kavramı yok, atlandı"
        fi
    fi
    if have bun; then sh_run bun upgrade || failed_cmds+=("bun upgrade"); did=1; fi
    (( did == 0 )) && { skip_module "node paket yöneticisi yok"; return 99; }

    if (( DRY_RUN == 1 )); then
        if (( before_n + volta_n > 0 )); then module_available "$((before_n + volta_n)) npm global paketi güncellenecekti"
        else module_planned "npm/pnpm/bun komutları gösterildi"; fi
        return 0
    fi

    if [[ -n "$blocked_pkgs" ]]; then
        warn "npm allowScripts kurulum script'lerini engelledi: $blocked_pkgs — native modüller çalışmayabilir (npm approve-scripts <paket>)"
        reasons+=("script'i engellenen: $blocked_pkgs")
    fi
    (( after_n > 0 )) && reasons+=("hâlâ eski: $(paste -sd' ' - <<<"$names_after")")
    (( ${#failed_cmds[@]} > 0 )) && reasons+=("başarısız: $(join_list "${failed_cmds[@]}")")

    if (( ${#reasons[@]} > 0 )); then
        local joined
        joined=$(printf '%s; ' "${reasons[@]}"); joined="${joined%; }"
        module_partial "$changed paket güncellendi; $joined"
    elif (( changed > 0 )); then
        module_updated "$changed global paket güncellendi"
    else
        module_current "global Node paketleri güncel"
    fi
    return 0
}

# Yalnız izole araç yöneticileri güncellenir (pipx, uv tool, poetry self).
# pip3 / brew Python / conda'ya dokunulmaz (PEP 668, kullanıcı kuralı).
mod_python() {
    local did=0 changed=0 out rc
    local -a failed_cmds=()
    if have pipx; then
        did=1
        run_capture out pipx upgrade-all; rc=$?
        if (( QUIET == 0 )) && [[ -n "$out" ]]; then
            grep -E '^(upgraded package|No packages upgraded|upgrading )' <<<"$out" | tail -30 || true
        fi
        changed=$((changed + $(grep -c '^upgraded package ' <<<"$out" || true)))
        (( rc != 0 )) && failed_cmds+=("pipx upgrade-all")
    fi
    if have uv; then
        did=1
        local tools
        capture_stdout tools uv tool list || true
        if grep -qE '^[^-[:space:]]' <<<"$tools" && ! grep -q '^No tools installed' <<<"$tools"; then
            run_capture out uv tool upgrade --all; rc=$?
            (( QUIET == 0 )) && [[ -n "$out" ]] && printf '%s\n' "$out"
            changed=$((changed + $(grep -c '^Updated ' <<<"$out" || true)))
            (( rc != 0 )) && failed_cmds+=("uv tool upgrade --all")
        else
            note "uv tool ile kurulu araç yok"
        fi
    fi
    if have poetry; then
        did=1
        sh_run poetry self update || { warn "poetry self-update başarısız"; failed_cmds+=("poetry self update"); }
    fi
    if have conda; then
        note "conda'ya dokunulmadı (yalnız rapor): $(conda --version 2>/dev/null || echo '?')"
    fi
    if (( AGGRESSIVE_CLEAN == 1 )) && have pip3; then
        sh_run pip3 cache purge || true
    fi
    (( did == 0 )) && { skip_module "izole Python araç yöneticisi yok (pipx/uv/poetry)"; return 99; }

    if (( DRY_RUN == 1 )); then module_planned "pipx/uv tool/poetry komutları gösterildi"; return 0; fi
    if (( ${#failed_cmds[@]} > 0 )); then module_partial "$changed araç güncellendi; başarısız: $(join_list "${failed_cmds[@]}")"
    elif (( changed > 0 )); then module_updated "$changed araç güncellendi"
    else module_current "yönetilen Python araçları güncel"; fi
    return 0
}

mod_rust() {
    have rustup || { skip_module "rustup yok"; return 99; }
    local out changed=0 rc
    local -a failed_cmds=()
    run_capture out rustup update; rc=$?
    (( QUIET == 0 )) && [[ -n "$out" ]] && printf '%s\n' "$out"
    grep -qE ' updated - rustc|installed - rustc' <<<"$out" && changed=$((changed+1))
    (( rc != 0 )) && failed_cmds+=("rustup update")
    # auto-self-update açıksa rustup update kendini zaten denetler
    grep -q 'checking for self-update' <<<"$out" || sh_run rustup self update || true
    if have cargo && cargo install-update --version >/dev/null 2>&1; then
        run_capture out cargo install-update -a; rc=$?
        (( QUIET == 0 )) && [[ -n "$out" ]] && printf '%s\n' "$out"
        grep -q 'Overall updated [1-9]' <<<"$out" && changed=$((changed+1))
        (( rc != 0 )) && failed_cmds+=("cargo install-update -a")
    else
        note "cargo-update yok (cargo install cargo-update)"
    fi
    if (( DRY_RUN == 1 )); then module_planned "rustup/cargo komutları gösterildi"; return 0; fi
    if (( ${#failed_cmds[@]} > 0 )); then module_partial "başarısız: $(join_list "${failed_cmds[@]}")"
    elif (( changed > 0 )); then module_updated "toolchain veya cargo paketleri güncellendi"
    else module_current "Rust toolchain ve cargo paketleri güncel"; fi
    return 0
}

ruby_permission_problem() {
    local gem_bin="$1" gemdir plugin_dir p
    gemdir=$(env -u GEM_HOME -u GEM_PATH "$gem_bin" env gemdir 2>/dev/null) || return 1
    plugin_dir="$gemdir/plugins"
    [[ -d "$plugin_dir" ]] || return 1
    [[ -w "$plugin_dir" ]] || { printf '%s (dizin yazılamıyor)' "$plugin_dir"; return 0; }
    # RubyGems plugin dosyalarını yeniden yazar; symlink ise hedefine yazar.
    # Brew Ruby'de hedef Cellar'daki salt-okunur dosya olabilir (EACCES).
    while IFS= read -r -d '' p; do
        [[ -w "$p" ]] && continue
        if [[ -L "$p" ]]; then
            printf '%s → %s (symlink hedefi salt-okunur)' "$p" "$(readlink "$p")"
        else
            printf '%s (dosya yazılamıyor)' "$p"
        fi
        return 0
    done < <(find "$plugin_dir" -maxdepth 1 \( -type f -o -type l \) -print0 2>/dev/null)
    return 1
}

ruby_gem_bin() {
    local prefix
    if have brew; then
        prefix=$(brew --prefix ruby 2>/dev/null)
        [[ -n "$prefix" && -x "$prefix/bin/gem" ]] && { printf '%s' "$prefix/bin/gem"; return 0; }
    fi
    have gem && { printf 'gem'; return 0; }
    return 1
}

# Ruby ile gelen gem adları: varsayılan gem'ler ve Ruby'nin kendi gem dizinindeki
# bundled gem'ler (Gem.dir/Gem.user_dir dışı; brew'da Cellar). Bunlar `brew
# upgrade ruby` ile gelir; gem update'e verilince io-wait 1.0.0 (yalnız
# deprecation uyarısı basan sürüm) ve rdoc 7+8 çift yüklemesi oluşmuştu.
ruby_shipped_gems() {
    local gem_bin="$1" ruby_bin=ruby
    [[ "$gem_bin" == */* ]] && ruby_bin="${gem_bin%/*}/ruby"
    env -u GEM_HOME -u GEM_PATH "$ruby_bin" -e \
        'puts Gem::Specification.select { |s| s.default_gem? || ![Gem.dir, Gem.user_dir].include?(s.base_dir) }.map(&:name).uniq' 2>/dev/null
}

mod_ruby() {
    local gem_bin gemdir bad before after changed=0 rc before_n after_n shipped targets skipped
    local -a failed_cmds=() update_args=()
    gem_bin=$(ruby_gem_bin) || { skip_module "gem yok"; return 99; }
    gemdir=$(env -u GEM_HOME -u GEM_PATH "$gem_bin" env gemdir 2>/dev/null)
    if [[ "$gemdir" == /usr/* || "$gemdir" == /System/* || "$gemdir" == /Library/* || ! -w "$gemdir" ]]; then
        skip_module "Ruby gem dizini yazılamıyor: $gemdir"; return 99
    fi
    if bad=$(ruby_permission_problem "$gem_bin"); then
        warn "Ruby plugin yolu yazılamıyor: $bad — sudo/chown yapılmadı; symlink ise hedefin yazılabilir bir kopyasıyla değiştir"
        module_partial "gem update çalıştırılmadı: $bad"
        return 0
    fi

    # Sayım yalnız stdout'tan: çift yüklenen rdoc vb. stderr uyarıları sayılmaz.
    # Ruby ile gelen gem'ler ne güncellenir ne de "hâlâ eski" sayılır.
    capture_stdout before env -u GEM_HOME -u GEM_PATH "$gem_bin" outdated || true
    shipped=$(ruby_shipped_gems "$gem_bin" || true)
    targets=$(gem_user_outdated "$before" "$shipped")
    skipped=$(gem_outdated_names "$before" | grep -xF -f <(printf '%s\n' "$shipped") || true)
    before_n=$(line_count "$targets")
    if [[ -n "$skipped" ]]; then
        note "Ruby ile gelen $(line_count "$skipped") gem atlandı (brew upgrade ruby ile gelir; adlar logda)"
        printf 'Ruby ile gelen, atlanan gem: %s\n' "$(paste -sd' ' - <<<"$skipped")" >>"$LOG_FILE"
    fi
    sh_run_quiet '^(Successfully installed|Gems updated|RubyGems .+ installed|Latest version|ERROR)' \
        env -u GEM_HOME -u GEM_PATH "$gem_bin" update --system --no-document
    rc=$?; (( rc != 0 )) && failed_cmds+=("gem update --system")
    if [[ -n "$targets" ]]; then
        mapfile -t update_args <<<"$targets"
        sh_run_quiet '^(Successfully installed|Gems updated|ERROR)' \
            env -u GEM_HOME -u GEM_PATH "$gem_bin" update --no-document "${update_args[@]}"
        rc=$?; (( rc != 0 )) && failed_cmds+=("gem update")
    fi
    sh_run_quiet '^(Successfully uninstalled|Clean up complete|ERROR)' \
        env -u GEM_HOME -u GEM_PATH "$gem_bin" cleanup
    rc=$?; (( rc != 0 )) && failed_cmds+=("gem cleanup")

    if (( DRY_RUN == 1 )); then
        if (( before_n > 0 )); then module_available "$before_n gem güncellenecekti"
        else module_current "RubyGems ve gem'ler güncel"; fi
        return 0
    fi

    capture_stdout after env -u GEM_HOME -u GEM_PATH "$gem_bin" outdated || true
    after_n=$(line_count "$(gem_user_outdated "$after" "$shipped")")
    changed=$(( before_n - after_n ))
    (( changed < 0 )) && changed=0
    if (( ${#failed_cmds[@]} > 0 )); then module_partial "$changed gem güncellendi; başarısız: $(join_list "${failed_cmds[@]}")"
    elif (( after_n > 0 )); then module_partial "$changed gem güncellendi; $after_n gem hâlâ eski"
    elif (( changed > 0 )); then module_updated "$changed gem güncellendi"
    else module_current "RubyGems ve gem'ler güncel"; fi
    return 0
}

mod_go() {
    have go || { skip_module "go yok"; return 99; }
    (( GO_CLEAN == 0 )) && { skip_module "Go cache temizliği isteğe bağlı (--go-clean)"; return 99; }
    sh_run go clean -cache || { module_failed "go build cache temizlenemedi"; return 1; }
    if (( AGGRESSIVE_CLEAN == 1 )); then sh_run go clean -modcache || true; fi
    module_completed "Go cache temizlendi"
}

mod_docker() {
    [[ $SKIP_DOCKER -eq 1 ]] && { skip_module "--skip-docker"; return 99; }
    (( DOCKER_PRUNE == 0 )) && { skip_module "Docker prune isteğe bağlı (--docker-prune)"; return 99; }
    have docker || { skip_module "docker yok"; return 99; }
    docker info >/dev/null 2>&1 || { skip_module "Docker daemon kapalı"; return 99; }
    sh_run docker system df || true
    local args=(system prune -af) failed=0
    if (( DOCKER_PRUNE_VOLUMES == 1 )); then
        warn "Docker volume temizliği kalıcı verileri silebilir"
        confirm "Kullanılmayan volume'ler de silinsin mi?" "N" || { skip_module "Volume prune yapılmadı — $CONFIRM_WHY"; return 99; }
        args+=(--volumes)
    fi
    sh_run docker "${args[@]}" || failed=1
    if docker buildx version >/dev/null 2>&1; then sh_run docker builder prune -af || failed=1
    else note "docker buildx bulunamadı; builder prune atlandı"; fi
    if (( failed == 1 )); then module_partial "bazı Docker temizlikleri başarısız"
    else module_completed "kullanılmayan Docker verileri temizlendi"; fi
    return 0
}

# Bakım (--maintenance): paket yöneticisi cache'lerinin güvenli bakımı.
mod_cache() {
    [[ $SKIP_CACHE -eq 1 ]] && { skip_module "--skip-cache"; return 99; }
    (( RUN_MAINTENANCE == 0 )) && { skip_module "Bakım isteğe bağlı (--maintenance)"; return 99; }
    local before after uv_rc=0
    before=$(disk_used_kb "$HOME/Library/Caches/Homebrew")
    info "Güvenli kullanıcı cache bakımı"
    if have npm; then sh_run npm cache verify || true; fi
    if have uv; then
        # Çalışan uv süreçleri (ör. uvx ile açılmış MCP sunucuları) cache
        # kilidini tutar; prune o zaman zaman aşımına kadar boşuna bekler.
        local uv_busy
        uv_busy=$(pgrep -x uv 2>/dev/null | wc -l | tr -d ' ')
        if (( uv_busy > 0 )); then
            note "uv cache prune atlandı: $uv_busy uv süreci çalışıyor (uvx ile açık MCP sunucuları cache kilidini tutar)"
        else
            run_with_timeout "$UV_PRUNE_TIMEOUT" uv cache prune || uv_rc=$?
            if (( uv_rc == 124 )); then
                warn "uv cache prune ${UV_PRUNE_TIMEOUT} sn'de bitmedi, zaman aşımı (başka bir uv süreci cache kilidini tutuyor olabilir); atlandı"
            elif (( uv_rc != 0 )); then
                warn "uv cache prune başarısız (rc=$uv_rc)"
            fi
        fi
    fi
    if have pnpm; then sh_run pnpm store prune || true; fi
    if have brew; then sh_run brew cleanup || true; fi
    if (( XCODE_CLEAN == 1 && SKIP_XCODE == 0 )); then
        note "Xcode DerivedData ve kullanılamayan simülatörler temizleniyor; Archives korunur"
        safe_rm "$HOME/Library/Developer/Xcode/DerivedData"/*
        safe_rm "$HOME/Library/Developer/CoreSimulator/Caches"/*
        if have xcrun && xcrun -f simctl >/dev/null 2>&1; then sh_run xcrun simctl delete unavailable || true; fi
    fi
    if (( AGGRESSIVE_CLEAN == 1 )); then
        warn "Agresif temizlik etkin; yalnız bilinen cache yolları silinecek"
        if have yarn; then sh_run yarn cache clean || true; fi
        safe_rm "$HOME/Library/Caches/com.apple.dt.Xcode"
        safe_rm "$HOME/Library/Caches/org.swift.swiftpm"
        safe_rm "$HOME/Library/Logs/Homebrew"
    fi
    after=$(disk_used_kb "$HOME/Library/Caches/Homebrew")
    note "Homebrew cache: $(human_kb "$before") → $(human_kb "$after")"
    if (( after < before )); then module_updated "$(human_kb $((before-after))) temizlendi"
    else module_completed "cache bakımı tamam"; fi
    return 0
}

# brew services list: yalnız "none" olmayan satırlar gösterilir, "error"
# durumundaki servisler uyarılır (KeepAlive'lı LaunchAgent çökme döngüsünde
# kalabilir). Özet BREW_SVC_DETAIL'e yazılır.
brew_services_check() {
    local out rc failed running
    log "${DIM}\$ brew services list${RESET}"
    capture_stdout out brew services list; rc=$?
    (( rc != 0 )) && return "$rc"
    if (( QUIET == 0 )) && awk 'NR>1 && $2!="none" {f=1} END {exit !f}' <<<"$out"; then
        awk 'NR==1 || $2!="none"' <<<"$out"
    fi
    failed=$(awk 'NR>1 && $2=="error" {print $1}' <<<"$out" | paste -sd' ' -)
    running=$(awk 'NR>1 && $2=="started" {print $1}' <<<"$out" | paste -sd' ' -)
    [[ -n "$failed" ]] && warn "brew servisi hata durumunda: $failed — ayrıntı: brew services info <ad>; gerekmiyorsa: brew services stop <ad>"
    BREW_SVC_DETAIL="çalışan: ${running:-yok}${failed:+; hatalı: $failed}"
    return 0
}

mod_brew_services() {
    have brew || { skip_module "brew yok"; return 99; }
    brew_services_check || { module_partial "servis listesi alınamadı"; return 0; }
    module_completed "$BREW_SVC_DETAIL"
}


