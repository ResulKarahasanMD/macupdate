# oh-my-zsh + custom eklenti/tema depoları. Ekrana yalnız sonuç satırları
# ("+N commit"); banner ve git çıktısı loga. Eklenti hook'ları çalıştırılmaz.
mod_omz() {
    [[ -d "$HOME/.oh-my-zsh" ]] || { skip_module "oh-my-zsh yok"; return 99; }
    local out d name before after n
    local -a failed_cmds=() updated=()
    run_capture out env DISABLE_UPDATE_PROMPT=true "$HOME/.oh-my-zsh/tools/upgrade.sh" \
        || failed_cmds+=("omz upgrade")
    if (( QUIET == 0 )) && [[ -n "$out" ]]; then
        grep -iE 'has been updated|already at the latest|error|fail' <<<"$out" | head -3 || true
    fi
    grep -qi 'has been updated' <<<"$out" && updated+=("oh-my-zsh")

    for d in "$HOME/.oh-my-zsh/custom/plugins"/* "$HOME/.oh-my-zsh/custom/themes"/*; do
        [[ -d "$d/.git" ]] || continue
        name=$(basename "$d")
        if (( DRY_RUN == 1 )); then log "${DIM}\$ git -C $d pull --ff-only${RESET}"; continue; fi
        before=$(git -C "$d" rev-parse HEAD 2>/dev/null)
        if GIT_TERMINAL_PROMPT=0 git -C "$d" -c core.hooksPath=/dev/null pull --ff-only --quiet >>"$LOG_FILE" 2>&1; then
            after=$(git -C "$d" rev-parse HEAD 2>/dev/null)
            if [[ "$before" != "$after" ]]; then
                n=$(git -C "$d" rev-list --count "$before..$after" 2>/dev/null || echo "?")
                log "  ${GREEN}↑${RESET} $name +$n commit"
                updated+=("$name")
            fi
        else
            log "  ${RED}✗${RESET} $name: git pull --ff-only başarısız (ayrıntı logda)"
            failed_cmds+=("git pull $name")
        fi
    done

    (( DRY_RUN == 1 )) && { module_planned "omz ve eklenti güncellemeleri gösterildi"; return 0; }
    if (( ${#failed_cmds[@]} )); then module_partial "başarısız: $(join_list "${failed_cmds[@]}")"
    elif (( ${#updated[@]} )); then module_updated "güncellendi: $(join_list "${updated[@]}")"
    else module_current "oh-my-zsh ve eklentiler güncel"; fi
}

