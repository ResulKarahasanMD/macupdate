# AUDIT — Sistem denetimi (sadece rapor, hiçbir şey değiştirmez)
# ═════════════════════════════════════════════════════════════════════

mod_audit_unmanaged() {
    info "Brew cask ve App Store dışında kalan /Applications uygulamaları"
    info "(bunlar manuel güncellenmek zorunda)"

    local apps_dir="/Applications"
    [[ ! -d "$apps_dir" ]] && { skip_module "/Applications yok"; return 99; }

    # Cask ile yönetilen app adlarını topla
    local -a cask_apps=()
    if have brew; then
        while IFS= read -r cask; do
            # brew info --json cask → App[].name
            local names
            names=$(brew info --json=v2 --cask "$cask" 2>/dev/null | \
                    python3 -c "import sys, json; d=json.load(sys.stdin); [print(a) for c in d['casks'] for a in c.get('artifacts',[]) for a in (a.get('app',[]) if isinstance(a,dict) else [])]" 2>/dev/null || true)
            while IFS= read -r n; do [[ -n "$n" ]] && cask_apps+=("$n"); done <<< "$names"
        done < <(brew list --cask 2>/dev/null)
    fi

    # App Store (mas) tarafından yönetilenler
    local -a mas_apps=()
    if have mas; then
        while IFS= read -r line; do
            # Format: "ID AppName (version)" — ad middle kısım
            local name; name=$(echo "$line" | sed -E 's/^[0-9]+ +//' | sed -E 's/ +\([0-9.]+\)$//')
            [[ -n "$name" ]] && mas_apps+=("${name}.app")
        done < <(mas list 2>/dev/null)
    fi

    # /Applications altındaki tüm .app'leri tara
    local count=0
    log "\n${BOLD}Manuel yönetim gerektirenler:${RESET}"
    while IFS= read -r app; do
        local name; name=$(basename "$app")
        # Cask veya mas listesinde var mı?
        local managed=0
        for ca in "${cask_apps[@]}"; do [[ "$ca" == "$name" ]] && { managed=1; break; }; done
        [[ $managed -eq 0 ]] && for ma in "${mas_apps[@]}"; do [[ "$ma" == "$name" ]] && { managed=1; break; }; done

        if [[ $managed -eq 0 ]]; then
            local size; size=$(du -sh "$app" 2>/dev/null | awk '{print $1}')
            log "  ${YELLOW}●${RESET} $name (${size:-?})"
            ((count++))
        fi
    done < <(find "$apps_dir" -maxdepth 1 -name "*.app" -type d 2>/dev/null | sort)

    note "Toplam $count uygulama manuel güncelleme gerektiriyor"
    note "İpucu: ${BOLD}Latest.app${RESET} veya ${BOLD}Pearcleaner${RESET} ile kontrol et"
}

mod_audit_broken_casks() {
    info "Bozuk cask'ler (App dosyası kayıp)"
    have brew || { skip_module "brew yok"; return 99; }

    local broken=0
    while IFS= read -r cask; do
        [[ -z "$cask" ]] && continue
        # Cask'in yüklediği app adını bul
        local app_name
        app_name=$(brew info --json=v2 --cask "$cask" 2>/dev/null | \
                   python3 -c "import sys, json; d=json.load(sys.stdin); apps=[a for c in d['casks'] for a in c.get('artifacts',[]) for a in (a.get('app',[]) if isinstance(a,dict) else [])]; print(apps[0] if apps else '')" 2>/dev/null)

        [[ -z "$app_name" ]] && continue

        if [[ ! -e "/Applications/$app_name" && ! -e "$HOME/Applications/$app_name" ]]; then
            log "  ${RED}✗${RESET} $cask → $app_name (dosya kayıp)"
            ((broken++))
        fi
    done < <(brew list --cask 2>/dev/null)

    if (( broken > 0 )); then
        warn "$broken bozuk cask bulundu"
        note "Düzeltmek için her biri için: ${BOLD}brew uninstall --cask --force <ad> && brew install --cask <ad>${RESET}"
    else
        ok "Tüm cask'ler sağlam"
    fi
}

mod_audit_duplicates() {
    info "Kopya / bozuk uygulama dosyaları"
    local -a patterns=(
        "*.app arması"         # Türkçe "armor" suffix
