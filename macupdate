# GIT REPOS
# ═════════════════════════════════════════════════════════════════════

# repos_discover DİZİN — DİZİN altında REPOS_BUCKETS kovaları varsa yalnız
# onların doğrudan alt dizinlerindeki depolar; yoksa DİZİN'in doğrudan alt
# depoları (DİZİN'in kendisi depoysa o). İç içe klonlar ve worktree'ler
# (.git'i dosya olanlar) kapsam dışı.
repos_discover() {
    local dir="$1" b d found=0
    for b in "${REPOS_BUCKETS[@]}"; do
        [[ -d "$dir/$b" ]] || continue
        found=1
        for d in "$dir/$b"/*/; do [[ -d "${d}.git" ]] && printf '%s\n' "${d%/}"; done
    done
    if (( found == 0 )); then
        [[ -d "$dir/.git" ]] && printf '%s\n' "$dir"
        for d in "$dir"/*/; do [[ -d "${d}.git" ]] && printf '%s\n' "${d%/}"; done
    fi
    return 0
}

# repo_state DEPO — ağa çıkmadan: ok | no-remote | detached | no-upstream | dirty
# (izlenen dosyada değişiklik = dirty; yalnız izlenmeyen dosya engel değil,
# git onların üzerine yazacak bir birleştirmeyi zaten reddeder)
repo_state() {
    local r="$1"
    [[ -n "$(git -C "$r" remote 2>/dev/null)" ]] || { echo no-remote; return; }
    git -C "$r" symbolic-ref -q HEAD >/dev/null 2>&1 || { echo detached; return; }
    git -C "$r" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || { echo no-upstream; return; }
    [[ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$r" status --porcelain --untracked-files=no 2>/dev/null)" ]] \
        || { echo dirty; return; }
    echo ok
}

# repo_fetch DEPO ÇIKTI — etkileşimsiz, zaman aşımlı `git fetch --all --prune`.
# Arka planda paralel çalışır: dönüş kodu ÇIKTI'ya, git çıktısı ÇIKTI.log'a.
# Şifre/onay istemi beklemez (GIT_TERMINAL_PROMPT=0, ssh BatchMode).
repo_fetch() {
    local r="$1" out="$2" pid i=0 rc=0
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15" \
        git -C "$r" fetch --all --prune --quiet >"$out.log" 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if (( i >= REPOS_TIMEOUT * 5 )); then
            pkill -TERM -P "$pid" 2>/dev/null
            kill -TERM "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
            echo "zaman aşımı (${REPOS_TIMEOUT} sn)" >>"$out.log"
            echo 124 >"$out"
            return 0
        fi
        sleep 0.2
        ((i+=1))
    done
    wait "$pid" || rc=$?
    echo "$rc" >"$out"
}

# repos_by_group DEPO... — kova başına tek satır: "  kova (n): ad ad …"
# (sıra korunur; kovasız depolar REPOS_DIR adıyla gruplanır)
repos_by_group() {
    local r rel grp prev="" line="" n=0
    for r in "$@"; do
        rel="${r#"$REPOS_DIR"/}"
        if [[ "$rel" == */* ]]; then grp="${rel%%/*}"; rel="${rel#*/}"; else grp="${REPOS_DIR##*/}"; fi
        if [[ -n "$prev" && "$grp" != "$prev" ]]; then log "  $prev ($n):$line"; line=""; n=0; fi
        prev="$grp"; line+=" $rel"; ((n+=1))
    done
    [[ -n "$prev" ]] && log "  $prev ($n):$line"
    return 0
}

# --repos: depoları fetch eder, yalnız fast-forward ile günceller. Rebase,
# merge commit, stash, reset yok; depo hook'ları çalıştırılmaz.
mod_repos() {
    have git || { skip_module "git yok"; return 99; }
    [[ -d "$REPOS_DIR" ]] || { skip_module "$REPOS_DIR yok"; return 99; }
    local r name i p running ahead behind tmpd why gone_note=""
    local -a repos=() todo=() pids=() updated=() problems=() parts=() gone=()
    local -a skip_dirty=() skip_noup=() skip_detached=() skip_noremote=()
    mapfile -t repos < <(repos_discover "$REPOS_DIR")
    (( ${#repos[@]} == 0 )) && { skip_module "$REPOS_DIR altında depo yok"; return 99; }

    for r in "${repos[@]}"; do
        name="${r#"$REPOS_DIR"/}"
        case "$(repo_state "$r")" in
            ok)          todo+=("$r") ;;
            dirty)       skip_dirty+=("$name") ;;
            no-upstream) skip_noup+=("$name") ;;
            detached)    skip_detached+=("$name") ;;
            *)           skip_noremote+=("$name") ;;
        esac
    done
    info "Git depoları: ${#repos[@]} (${REPOS_DIR/#$HOME/\~}); ${#todo[@]} tanesi fetch + ff-only"
    (( ${#skip_dirty[@]} ))    && parts+=("${#skip_dirty[@]} yerel değişiklikli")
    (( ${#skip_noup[@]} ))     && parts+=("${#skip_noup[@]} upstream'siz")
    (( ${#skip_detached[@]} )) && parts+=("${#skip_detached[@]} detached HEAD")
    (( ${#skip_noremote[@]} )) && parts+=("${#skip_noremote[@]} remote'suz")
    if (( ${#parts[@]} )); then
        note "Dokunulmadı: $(join_list "${parts[@]}") (adlar logda)"
        {
            (( ${#skip_dirty[@]} ))    && printf 'repos — yerel değişiklikli: %s\n' "$(join_list "${skip_dirty[@]}")"
            (( ${#skip_noup[@]} ))     && printf "repos — upstream'siz: %s\n" "$(join_list "${skip_noup[@]}")"
            (( ${#skip_detached[@]} )) && printf 'repos — detached HEAD: %s\n' "$(join_list "${skip_detached[@]}")"
            (( ${#skip_noremote[@]} )) && printf "repos — remote'suz: %s\n" "$(join_list "${skip_noremote[@]}")"
        } >>"$LOG_FILE"
    fi
    (( ${#todo[@]} == 0 )) && { module_current "güncellenecek depo yok"; return 0; }

    if (( DRY_RUN == 1 )); then
        log "${DIM}\$ git fetch --all --prune && git merge --ff-only @{u}  (${#todo[@]} depo)${RESET}"
        repos_by_group "${todo[@]}"
        module_planned "${#todo[@]} depo fetch + ff-only edilecekti"
        return 0
    fi

    tmpd=$(mktemp -d "${TMPDIR:-/tmp}/macupdate-repos.XXXXXX") || { module_failed "geçici dizin açılamadı"; return 1; }
    log "${DIM}\$ git fetch --all --prune  (${#todo[@]} depo, ${REPOS_JOBS} paralel, depo başı ${REPOS_TIMEOUT} sn)${RESET}"
    for i in "${!todo[@]}"; do
        while :; do
            running=0
            for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null && ((running+=1)); done
            (( running < REPOS_JOBS )) && break
            sleep 0.2
        done
        repo_fetch "${todo[$i]}" "$tmpd/$i" &
        pids+=("$!")
    done
    for p in "${pids[@]}"; do wait "$p" 2>/dev/null || true; done

    for i in "${!todo[@]}"; do
        r="${todo[$i]}"; name="${r#"$REPOS_DIR"/}"
        if [[ -s "$tmpd/$i.log" ]]; then
            printf '── repos: %s\n' "$name" >>"$LOG_FILE"
            cat "$tmpd/$i.log" >>"$LOG_FILE"
        fi
        if [[ "$(cat "$tmpd/$i" 2>/dev/null)" != 0 ]]; then
            why=$(grep -m1 -E '^(fatal|error):|zaman aşımı' "$tmpd/$i.log" 2>/dev/null || tail -n 1 "$tmpd/$i.log" 2>/dev/null)
            log "  ${RED}✗${RESET} $name: fetch başarısız${why:+ — $why}"
            problems+=("$name (fetch)")
            continue
        fi
        # fetch --prune silinen uzak dalın izini kaldırır; "güncel" sayılmasın
        if ! git -C "$r" rev-parse --verify -q '@{u}' >/dev/null 2>&1; then
            gone+=("$name")
            continue
        fi
        behind=$(git -C "$r" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
        ahead=$(git -C "$r" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
        (( behind == 0 )) && continue
        if (( ahead > 0 )); then
            log "  ${YELLOW}⇅${RESET} $name: ayrışmış (yerel +$ahead, uzak +$behind commit) — elle birleştir"
            problems+=("$name (ayrışmış)")
            continue
        fi
        if git -C "$r" -c core.hooksPath=/dev/null merge --ff-only --quiet '@{u}' >>"$LOG_FILE" 2>&1; then
            log "  ${GREEN}↑${RESET} $name +$behind commit"
            updated+=("$name")
        else
            log "  ${RED}✗${RESET} $name: ff-only birleştirilemedi (ayrıntı logda)"
            problems+=("$name (merge)")
        fi
    done
    rm -rf "$tmpd"

    if (( ${#gone[@]} )); then
        note "Dalın upstream'i silinmiş (PR birleşip uzak dal silinmiş olabilir), dokunulmadı: $(join_list "${gone[@]}")"
        gone_note="; ${#gone[@]} depoda upstream silinmiş"
    fi
    if (( ${#problems[@]} > 0 )); then
        module_partial "${#updated[@]} depo güncellendi; sorunlu: $(join_list "${problems[@]}")${gone_note}"
    elif (( ${#updated[@]} > 0 )); then
        module_updated "${#updated[@]} depo güncellendi${gone_note}"
    else
        module_current "$(( ${#todo[@]} - ${#gone[@]} )) depo güncel${gone_note}"
    fi
    return 0
}

# ═════════════════════════════════════════════════════════════════════
# INVENTORY — Kurulu her şeyin tarihli snapshot'ı (+ önceki ile diff)
# ═════════════════════════════════════════════════════════════════════

# İki snapshot'ın normalize manifest'lerini karşılaştır
_inv_diff() {
    local prev="$1" cur="$2"
    [[ -f "$prev/manifest.txt" && -f "$cur/manifest.txt" ]] || return 0
    local added removed
    added=$(comm -13 "$prev/manifest.txt" "$cur/manifest.txt" || true)
    removed=$(comm -23 "$prev/manifest.txt" "$cur/manifest.txt" || true)

    if [[ -z "$added" && -z "$removed" ]]; then
        ok "Değişiklik yok ($(basename "$prev") ile aynı)"
        return 0
    fi
    log "\n${BOLD}Değişiklikler ($(basename "$prev") → şimdi):${RESET}"
    while IFS= read -r l; do [[ -n "$l" ]] && log "  ${GREEN}+ $l${RESET}"; done <<< "$added"
    while IFS= read -r l; do [[ -n "$l" ]] && log "  ${RED}- $l${RESET}"; done <<< "$removed"
}

mod_inventory() {
    local stamp out
    stamp=$(date +%Y%m%d-%H%M%S)
    out="$INVENTORY_DIR/$stamp"

    info "Envanter klasörü: $out"
    if [[ $DRY_RUN -eq 1 ]]; then
        note "dry-run: envanter yazılmayacak"
        return 0
    fi
    mkdir -p "$out" || { skip_module "Klasör oluşturulamadı: $out"; return 99; }

    # ── Tam dökümler (insan-okur + arşiv) ────────────────────────────
    if have brew; then
        brew bundle dump --describe --file="$out/Brewfile" --force >/dev/null 2>&1 \
            && ok "Brewfile (yeniden kurulabilir: brew bundle install)"
        brew leaves --installed-on-request > "$out/brew-manual.txt" 2>/dev/null
        brew list --formula                > "$out/brew-formulae.txt" 2>/dev/null
        brew list --cask                   > "$out/brew-casks.txt" 2>/dev/null
        brew services list                 > "$out/brew-services.txt" 2>/dev/null
    fi
    have mas      && mas list                       > "$out/mas.txt" 2>/dev/null
    have npm      && npm ls -g --depth=0            > "$out/npm-global.txt" 2>/dev/null
    have pnpm     && pnpm ls -g                     > "$out/pnpm-global.txt" 2>/dev/null
    have yarn     && yarn global list               > "$out/yarn-global.txt" 2>/dev/null
    have bun      && bun pm ls -g                   > "$out/bun-global.txt" 2>/dev/null
    have pipx     && pipx list                      > "$out/pipx.txt" 2>/dev/null
    have pip3     && pip3 freeze                     > "$out/pip-freeze.txt" 2>/dev/null
    have cargo    && cargo install --list           > "$out/cargo.txt" 2>/dev/null
    have gem      && gem list                        > "$out/gem.txt" 2>/dev/null
    have composer && composer global show            > "$out/composer.txt" 2>/dev/null
    have rustup   && rustup show                     > "$out/rustup.txt" 2>/dev/null
    if have go; then
        ls -1 "$(go env GOPATH 2>/dev/null)/bin" > "$out/go-bin.txt" 2>/dev/null || true
    fi
    have code     && code --list-extensions         > "$out/vscode-ext.txt" 2>/dev/null
    have cursor   && cursor --list-extensions        > "$out/cursor-ext.txt" 2>/dev/null

    # GUI app'ler — isim + versiyon (Info.plist; system_profiler -json bazen boş döner)
    {
        for _appdir in /Applications "$HOME/Applications"; do
            [[ -d "$_appdir" ]] || continue
            for _app in "$_appdir"/*.app; do
                [[ -d "$_app" ]] || continue
                _v=$(defaults read "$_app/Contents/Info" CFBundleShortVersionString 2>/dev/null \
                     || defaults read "$_app/Contents/Info" CFBundleVersion 2>/dev/null || echo "?")
                printf '%s\t%s\n' "$(basename "$_app" .app)" "$_v"
            done
        done
    } 2>/dev/null | sort > "$out/applications.txt"

    launchctl list                                    > "$out/launchd.txt" 2>/dev/null
    osascript -e 'tell application "System Events" to get the name of every login item' \
        > "$out/login-items.txt" 2>/dev/null
    { sw_vers; echo; uname -a; echo; system_profiler SPHardwareDataType SPSoftwareDataType; } \
        > "$out/system.txt" 2>/dev/null

    # ── Normalize manifest (versiyon yok) — diff için tek kaynak ──────
    {
        have brew && brew leaves --installed-on-request 2>/dev/null | sed 's/^/brew:  /'
        have brew && brew list --cask 2>/dev/null                    | sed 's/^/cask:  /'
        have mas  && mas list 2>/dev/null | sed -E 's/^ *[0-9]+ +//; s/ +\([^)]*\)$//' | sed 's/^/mas:   /'
        have npm  && npm ls -g --depth=0 2>/dev/null | awk 'NF>1 && $NF ~ /@/ {print $NF}' | sed -E 's/@[^@/]*$//' | sed 's/^/npm:   /'
        have pipx && pipx list --short 2>/dev/null | awk '{print $1}'  | sed 's/^/pipx:  /'
        have cargo && cargo install --list 2>/dev/null | grep -E '^[a-z]' | awk '{print $1}' | sed 's/^/cargo: /'
        have code && code --list-extensions 2>/dev/null | sed 's/^/code:  /'
        [[ -f "$out/applications.txt" ]] && cut -f1 "$out/applications.txt" | sed 's/^/app:   /'
    } 2>/dev/null | sort -u > "$out/manifest.txt"

    local n; n=$(wc -l < "$out/manifest.txt" | tr -d ' ')
    ok "Envanter alındı — $n kalem · $out"

    # 'latest' symlink (kolay erişim)
    ln -sfn "$out" "$INVENTORY_DIR/latest" 2>/dev/null

    # ── Önceki snapshot ile diff ─────────────────────────────────────
    local prev
    prev=$(find "$INVENTORY_DIR" -maxdepth 1 -mindepth 1 -type d ! -name "$stamp" 2>/dev/null \
           | sort | tail -1)
    if [[ -n "$prev" ]]; then
        _inv_diff "$prev" "$out"
    else
        note "İlk snapshot — karşılaştırma için sonraki çalıştırmayı bekle"
    fi
    note "Git ile versiyonlamak istersen: cd $INVENTORY_DIR && git init && git add -A && git commit"
    return 0
}

mod_doctor() {
    local issues=0 checks=0 bad gem_bin
    ((checks+=1)); [[ "$(uname -s)" == "Darwin" ]] || { warn "macOS değil"; ((issues+=1)); }
    ((checks+=1)); (( $(disk_free_gb) >= 10 )) || { warn "Disk alanı 10 GB altında"; ((issues+=1)); }
    ((checks+=1)); xcode-select -p >/dev/null 2>&1 || { warn "Command Line Tools seçili değil"; ((issues+=1)); }
    if have brew; then
        ((checks+=1)); brew doctor >>"$LOG_FILE" 2>&1 || { warn "brew doctor uyarı verdi"; ((issues+=1)); }
    fi
    # 'cache' kontrolü cache'te çöp toplar (değiştirir), 'versions' ise volta
    # altında yalnız sürüm önerisidir; ikisi de çalıştırılmaz.
    if have npm; then ((checks+=1)); npm doctor connection registry environment permissions >>"$LOG_FILE" 2>&1 || { warn "npm doctor uyarı verdi (ayrıntı logda)"; ((issues+=1)); }; fi
    if have ruby || have gem; then
        gem_bin=$(ruby_gem_bin) || gem_bin="gem"
        ((checks+=1)); if bad=$(ruby_permission_problem "$gem_bin"); then warn "Ruby yazma izni sorunu: $bad"; ((issues+=1)); fi
    fi
    if have docker; then
        ((checks+=1)); docker info >>"$LOG_FILE" 2>&1 || note "Docker kurulu fakat daemon kapalı"
    fi
    if (( issues == 0 )); then module_current "$checks kontrol temiz"
    else module_partial "$issues/$checks kontrolde sorun"; fi
    return 0
}


mod_doctor_report() { mod_doctor; }

